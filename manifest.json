{
  "manifest_version": 3,
  "name": "Viva Engage Auto-Comment",
  "version": "1.0",
  "description": "Auto-detect new Viva Engage posts and post a predefined comment.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://engage.cloud.microsoft/*",
    "https://*.vivaengage.com/*",
    "https://*.yammer.com/*",
    "https://web.yammer.com/*",
    "https://*.microsoft.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.vivaengage.com/*",
        "https://engage.cloud.microsoft/*",
        "https://*.yammer.com/*",
        "https://web.yammer.com/*",
        "https://*.microsoft.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
